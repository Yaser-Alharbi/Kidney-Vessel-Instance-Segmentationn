{#- Story site template. Rendered by demo/build_site.py into docs/index.html.
    Never type a number here: pass it in from build_site and format it with a
    filter (f3, signed, pval, pct, rel, n, num). The build fails if a number
    in the page text has no source. -#}
{%- set T = stats.test.dice -%}
{%- set V = stats.val.dice -%}
{%- set TI = stats.test.iou -%}
{%- set VI = stats.val.iou -%}
{%- set H = meta.images.hero -%}
{%- macro dot(arm) -%}<span class="dot" style="background:{{ arm.color }}"></span>{%- endmacro -%}
{%- macro term(key, text) -%}<dfn class="term" data-term="{{ key }}" tabindex="0">{{ text }}</dfn>{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ lab_title }}</title>
  <meta name="description" content="{{ title }}: a U-Net study of stain augmentation for blood-vessel segmentation in kidney histology.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <script src="https://cdn.jsdelivr.net/npm/vega@{{ cdn['vega'] }}"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-lite@{{ cdn['vega-lite'] }}"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-embed@{{ cdn['vega-embed'] }}"></script>
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <a class="brand" href="#top">{{ lab_title }}</a>
    <div class="nav-links">
      <a href="#problem">Problem</a>
      <a href="#data">Data</a>
      <a href="#experiment">Experiment</a>
      <a href="#methods">Methods</a>
      <a href="#results">Results</a>
      <a href="#limits">Limitations</a>
      <a class="cta" href="{{ urls.lab }}">Live lab &rarr;</a>
    </div>
  </div>
</nav>

<!-- ================================================================ hero -->
<section class="hero" id="top">
  <div class="wrap">
    <p class="eyebrow">Deep learning &middot; Kidney histology &middot; Stain robustness</p>
    <h1>{{ title }}</h1>
    <p class="subtitle">{{ subtitle }}</p>
    <p class="lead">
      Pathology labs stain tissue slightly differently, and a model trained on one lab's colours
      can stumble on another's. I trained the same {{ term("unet", "U-Net") }} {{ n_arms|n }} ways,
      changing only how it handles stain colour, and repeated each recipe with {{ n_seeds|n }}
      different random {{ term("seed", "seeds") }}. Randomly varying the stain during training
      gave the most accurate vessel outlines on slides the model had never seen.
    </p>
    <div class="buttons">
      <a class="btn primary" href="#problem">Read the story</a>
      <a class="btn" href="{{ urls.lab }}">Open the live lab</a>
      <a class="btn" href="{{ urls.repo }}">Source code</a>
    </div>

    <div class="figrow three">
      <figure><img src="{{ H.tile }}" alt="Kidney tissue tile stained with PAS" width="512" height="512">
        <figcaption><strong>Input.</strong> A {{ cfg.image_size|n }} &times; {{ cfg.image_size|n }} pixel tile of kidney tissue.</figcaption></figure>
      <figure><img src="{{ H.gt }}" alt="The same tile with expert-labelled blood vessels in green" width="512" height="512">
        <figcaption><strong>Expert outline.</strong> Blood vessels marked by expert annotators (green).</figcaption></figure>
      <figure><img src="{{ H.pred }}" alt="The same tile with the stain-jitter model's prediction in blue" width="512" height="512">
        <figcaption><strong>Model output.</strong> What the stain-jitter model marks as vessel.</figcaption></figure>
    </div>
    <p class="fig-note">Selected example: a validation tile chosen because stain jitter helps a lot on it. Typical tiles are harder; see the results below.</p>

    <div class="stats">
      <div class="stat">
        <div class="value">{{ T[jitter].mean|f3 }} <span class="vs">vs {{ T[base].mean|f3 }}</span></div>
        <div class="label">Test {{ term("dice", "Dice") }}, stain jitter vs baseline</div>
        <p class="note">Average over {{ T[jitter].n|n }} training runs per recipe. Dice measures overlap with the labelled vessels; higher is better.</p>
      </div>
      <div class="stat">
        <div class="value">{{ n_runs|n }}</div>
        <div class="label">Training runs</div>
        <p class="note">{{ n_arms|n }} recipes &times; {{ n_seeds|n }} seeds, identical except for how stain colour is handled.</p>
      </div>
      <div class="stat">
        <div class="value">{{ meta.splits.test|n }}</div>
        <div class="label">Test tiles from {{ meta.splits.test_wsis|n }} unseen slides</div>
        <p class="note">Labels on these slides are auto-generated and noisy, so the scores compare recipes with each other, not absolute accuracy.</p>
      </div>
      <div class="stat">
        <div class="value">p = {{ T[jitter].p|pval }}</div>
        <div class="label">Paired one-sided {{ term("wilcoxon", "Wilcoxon") }} across runs</div>
        <p class="note">How likely a win this consistent would be if stain jitter made no real difference.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================= problem -->
<section id="problem">
  <div class="wrap">
    <p class="eyebrow">The problem</p>
    <h2>Same tissue, different colours</h2>
    <div class="text">
      <p>
        Kidney biopsies are cut into thin slices and stained so that structures show up under a
        microscope. The tissue here uses <strong>PAS</strong> (periodic acid&ndash;Schiff) with a
        haematoxylin counterstain: purple-blue for cell nuclei, magenta-pink for membranes and
        connective tissue. Finding the blood vessels is a step towards mapping the kidney's
        vasculature, which the HuBMAP project is building a reference atlas of.
      </p>
      <p>
        The catch is that stain colour is not standardised. Stain batch, staining time, slice
        thickness and scanner all shift the colours, so the same structure can look noticeably
        different from one lab, or one slide, to the next. A model that has only seen one colour
        profile tends to learn the colours instead of the shapes, and loses accuracy on new
        slides. This study tests four ways of dealing with that.
      </p>
    </div>
    <div class="figrow three">
      {%- for v in meta.images.variants %}
      <figure><img src="{{ v.src }}" alt="Tile re-stained at strength {{ v.strength|num }}" loading="lazy" width="384" height="384">
        <figcaption>Stain strength &times;{{ v.strength|num }}{% if loop.index0 == 1 %} (as scanned){% endif %}</figcaption></figure>
      {%- endfor %}
    </div>
    <p class="fig-note">The showcase tile with both stains scaled in {{ term("od", "optical-density") }} space, the same operation stain jitter uses during training. A real lab-to-lab shift looks much like this.</p>

    <details>
      <summary>How can a computer separate the two stains?</summary>
      <div class="body">
        <p>
          Each stain absorbs light in its own characteristic way. Converting RGB to optical
          density (how much light is absorbed) makes the stains add up linearly, and a fixed
          stain matrix (Ruifrok &amp; Johnston, 2001) then splits every pixel into a
          haematoxylin amount (H), an eosin-like amount (E) and a third residual channel. This
          is called {{ term("deconv", "colour deconvolution") }}. Both stain-aware recipes below
          work in this space.
        </p>
        <div class="figrow three">
          <figure><img src="{{ meta.images.channels.H }}" alt="Haematoxylin channel" loading="lazy" width="384" height="384"><figcaption><strong>H channel.</strong> Mostly nuclei.</figcaption></figure>
          <figure><img src="{{ meta.images.channels.E }}" alt="Eosin-like channel" loading="lazy" width="384" height="384"><figcaption><strong>E channel.</strong> Membranes and stroma.</figcaption></figure>
          <figure><img src="{{ meta.images.channels.macenko }}" alt="Macenko-normalised tile" loading="lazy" width="384" height="384"><figcaption><strong>Macenko-normalised.</strong> Recoloured to the fixed reference stain.</figcaption></figure>
        </div>
        <p class="small muted">Code: <a href="{{ code.hed_matrix }}">HED matrix</a> &middot; <a href="{{ code.macenko }}">Macenko normalisation</a></p>
      </div>
    </details>
  </div>
</section>

<!-- ================================================================ data -->
<section id="data">
  <div class="wrap">
    <p class="eyebrow">The data</p>
    <h2>Slides, tiles and an honest split</h2>
    <div class="text">
      <p>
        The data comes from the HuBMAP <em>Hacking the Human Vasculature</em> Kaggle challenge:
        whole-slide images ({{ term("wsi", "WSIs") }}) of human kidney cut into
        {{ cfg.image_size|n }} &times; {{ cfg.image_size|n }} {{ term("tile", "tiles") }}.
        {{ inspection.n_polygon_lines|n }} tiles carry polygon annotations, with
        {{ inspection.annotation_type_counts.blood_vessel|n }} blood-vessel outlines in total.
        Only blood vessels are used here; glomeruli and &ldquo;unsure&rdquo; regions are ignored.
      </p>
      <p>
        Vessels are small: on average they cover {{ coverage.mean|pct }} of a tile (median
        {{ coverage.median|pct }}). That imbalance shapes the loss function and the metric.
      </p>
    </div>

    <svg class="diagram" viewBox="0 0 1120 210" role="img" aria-label="Train, validation and test split by slide">
      {%- set boxes = [
        ("Train", meta.splits.train, meta.splits.train_wsis, "expert labels", "#5b93ef"),
        ("Validation", meta.splits.val, meta.splits.val_wsis, "expert labels", "#8ab4f8"),
        ("Test", meta.splits.test, meta.splits.test_wsis, "auto-generated labels", "#d6a03c")] %}
      {%- for name, tiles, slides, labels, colour in boxes %}
      {%- set x = loop.index0 * 380 %}
      <rect x="{{ x }}" y="10" width="350" height="180" rx="8" fill="#151a21" stroke="#262d37"/>
      <rect x="{{ x }}" y="10" width="4" height="180" fill="{{ colour }}"/>
      <text x="{{ x + 26 }}" y="46" class="lbl">{{ name|upper }}</text>
      <text x="{{ x + 26 }}" y="92" class="big">{{ tiles|n }} tiles</text>
      <text x="{{ x + 26 }}" y="124">from {{ slides|n }} slide{{ "s" if slides != 1 }}</text>
      <text x="{{ x + 26 }}" y="152" class="lbl">{{ labels }}</text>
      {%- endfor %}
    </svg>

    <div class="text">
      <p>
        <strong>Why split by slide, not by tile?</strong> Tiles from one slide share its stain
        and its patient. If tiles from the same slide sat in both training and test, the model
        could score well by recognising the slide, which says nothing about new slides. Every
        split here uses different slides, and the split code checks they never overlap. The test
        slides come from a different part of the dataset whose labels were generated
        automatically, so they are noisier than the expert labels.
      </p>
    </div>

    <div class="callout">
      <h3>Why the scores look low</h3>
      <p>
        A Dice around {{ T[jitter].mean|f3 }} sounds poor, but three things push it down, and
        none of them changes which recipe wins. The training set is {{ meta.splits.train|n }}
        tiles from {{ meta.splits.train_wsis|n }} slide. Vessels are thin and small, and Dice is
        harsh on small objects: missing a vessel's edge by a few pixels costs a large share of
        it. And the test labels are auto-generated, so some &ldquo;misses&rdquo; are label
        errors. The study is built to compare recipes against each other under identical
        conditions, not to chase a leaderboard score.
      </p>
    </div>
  </div>
</section>

<!-- ========================================================== experiment -->
<section id="experiment">
  <div class="wrap">
    <p class="eyebrow">The experiment</p>
    <h2>Four recipes, one variable</h2>
    <div class="text">
      <p>
        Every model is the same network with the same settings and the same data. The only
        thing that changes is what happens to the colours, during training and at test time.
        Each card shows the same tile passed through that recipe's training pipeline, so you
        can see what the model actually learns from.
      </p>
    </div>
    <div class="cards two">
      {%- for arm in arms %}
      <div class="card">
        <h3>{{ dot(arm) }}{{ arm.label }}</h3>
        <div class="id">{{ arm.id }}</div>
        <p>{{ arm.blurb }}</p>
        <dl class="kv">
          <dt>Training</dt><dd>{{ arm.train }}</dd>
          <dt>Test time</dt><dd>{{ arm.eval }}</dd>
        </dl>
        <div class="thumbs">
          {%- for src in meta.images.train_samples[arm.id] %}
          <img src="{{ src }}" alt="{{ arm.label }} training sample" loading="lazy" width="256" height="256">
          {%- endfor %}
        </div>
        {%- set mc = meta.images.macenko_check %}
        {%- if arm.id == mac and mc.n_odd %}
        <p class="fig-note" style="margin-top:10px">
          {%- if mc.odd_thumbs %} These samples are the same tile, only flipped or rotated, yet they come out in clearly different colours. That is real pipeline output, not a display error.{% endif %}
          Flipping or rotating only moves pixels, so the normalised colours should not change. Yet for {{ mc.n_odd|n }} of the {{ mc.n_orient|n }} orientations of this tile, the normalisation picks the stain colours differently from the unrotated tile. The model therefore sees inconsistent colours during training, which may be part of why this recipe scores lower. This was not tested directly.
        </p>
        {%- endif %}
        <p class="role"><strong>Why it is here.</strong> {{ arm.role }}</p>
      </div>
      {%- endfor %}
    </div>

    <h3 style="margin-top:56px">Training setup, and why</h3>
    <ul class="reasons">
      <li><span class="what">U-Net with a ResNet-34 encoder</span>
        <span class="why">The standard architecture for medical segmentation. The encoder starts from ImageNet weights, which helps with only {{ meta.splits.train|n }} training tiles.</span></li>
      <li><span class="what">{{ term("loss", "Dice + BCE loss") }}</span>
        <span class="why">Vessels are a small share of pixels, so plain per-pixel loss would reward predicting &ldquo;no vessel&rdquo;. The Dice term matches the evaluation metric; the BCE term keeps gradients smooth early in training. <a href="{{ code.loss }}">Code</a></span></li>
      <li><span class="what">AdamW, learning rate {{ cfg.lr|num }}, weight decay {{ cfg.weight_decay|num }}, cosine schedule</span>
        <span class="why">A conventional, well-behaved setup for fine-tuning a pretrained encoder; the learning rate decays smoothly to zero. <a href="{{ code.train }}">Code</a></span></li>
      <li><span class="what">Up to {{ cfg.epochs|n }} epochs, early stop after {{ cfg.early_stop_patience|n }}</span>
        <span class="why">Training stops once validation Dice has not improved for {{ cfg.early_stop_patience|n }} epochs, and the best epoch's weights are kept. This limits overfitting on a small training set.</span></li>
      <li><span class="what">Batch {{ cfg.batch_size|n }}, tiles {{ cfg.image_size|n }} &times; {{ cfg.image_size|n }}</span>
        <span class="why">Full tiles at native resolution, so thin vessels are not blurred away by resizing.</span></li>
      <li><span class="what">{{ n_seeds|n }} {{ term("seed", "seeds") }} per recipe</span>
        <span class="why">For statistical power. The comparison uses a paired test across runs, and with only {{ power.small_n|n }} runs per recipe the smallest p it can ever produce is {{ power.small_p|f3 }}, even if one recipe wins every time. With {{ n_seeds|n }} runs that floor drops to {{ power.full_p|pval }}. In the results, the run-to-run spread of the baseline (std {{ T[base].std|f3 }} on test) turned out to be about as large as the gap between recipes ({{ T[jitter].gain|signed }}), so a single run could easily have pointed the wrong way.</span></li>
    </ul>
    <p class="small muted">All {{ n_runs|n }} runs took {{ train_hours|round(1)|num }} hours of GPU time in total.</p>
  </div>
</section>

<!-- ============================================================= methods -->
<section id="methods">
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2>The algorithms, briefly</h2>
    <div class="pipeline">
      <div class="step"><b>Tile</b>{{ cfg.image_size|n }} &times; {{ cfg.image_size|n }} RGB</div><div class="arrow">&rarr;</div>
      <div class="step"><b>Colour step</b>depends on the recipe</div><div class="arrow">&rarr;</div>
      <div class="step"><b>U-Net</b>one score per pixel</div><div class="arrow">&rarr;</div>
      <div class="step"><b>Threshold</b>sigmoid &gt; {{ threshold|num }}</div><div class="arrow">&rarr;</div>
      <div class="step"><b>Vessel mask</b>compared with the label</div>
    </div>

    <div class="cards two">
      <div class="card">
        <h3>Stain jitter (HED jitter)</h3>
        <p>Randomly makes each stain a little stronger or weaker for every training tile, so the model never sees exactly the same colours twice.</p>
        <details><summary>How it works</summary><div class="body">
          <p>The tile is converted to optical density and split into H, E and residual channels by colour deconvolution. Each channel is multiplied by a random factor in 1 &plusmn; &sigma; and shifted by a random offset in &plusmn;&sigma;, then converted back to RGB. With &sigma; = {{ hed.sigma|num }}, applied to {{ hed.p|pct }} of training tiles.</p>
        </div></details>
        <details><summary>Details</summary><div class="body">
          <p class="small">Matrix: Ruifrok &amp; Johnston (2001). <a href="{{ code.hed_jitter }}">HEDJitter</a> &middot; <a href="{{ code.hed_builder }}">where the recipe sets &sigma; and p</a></p>
        </div></details>
      </div>
      <div class="card">
        <h3>Stain normalisation (Macenko)</h3>
        <p>Estimates each tile's own two stain colours, then repaints the tile as if it had been stained with one fixed reference.</p>
        <details><summary>How it works</summary><div class="body">
          <p>Background pixels are dropped and the rest are converted to optical density. The two main directions of variation (from an SVD) span a plane; the extreme angles in that plane give the tile's two stain vectors. Concentrations are rescaled so their upper percentile matches the reference, then recombined with the reference stain matrix. Degenerate tiles are returned unchanged.</p>
        </div></details>
        <details><summary>Details</summary><div class="body">
          <p class="small">Method: Macenko et al. (2009). The reference stain matrix comes from H&amp;E, which is exactly what the second hypothesis questions for PAS. <a href="{{ code.macenko }}">MacenkoNormalize</a></p>
        </div></details>
      </div>
      <div class="card">
        <h3>U-Net with a ResNet-34 encoder</h3>
        <p>An encoder shrinks the tile into increasingly abstract features; a decoder expands them back to full resolution to label every pixel.</p>
        <details><summary>How it works</summary><div class="body">
          <svg class="diagram" viewBox="0 0 520 200" role="img" aria-label="U-Net diagram">
            {%- for i in range(4) %}
            <rect x="{{ 20 + i * 60 }}" y="{{ 20 + i * 36 }}" width="44" height="{{ 150 - i * 36 }}" rx="4" fill="#1b212a" stroke="#5b93ef"/>
            <rect x="{{ 456 - i * 60 }}" y="{{ 20 + i * 36 }}" width="44" height="{{ 150 - i * 36 }}" rx="4" fill="#1b212a" stroke="#8ab4f8"/>
            {%- if i < 3 %}<line x1="{{ 64 + i * 60 }}" y1="{{ 32 + i * 36 }}" x2="{{ 456 - i * 60 }}" y2="{{ 32 + i * 36 }}" stroke="#3a424d" stroke-dasharray="4 4"/>{% endif %}
            {%- endfor %}
            <text x="20" y="196" class="lbl">encoder (ResNet-34)</text>
            <text x="390" y="196" class="lbl">decoder</text>
            <text x="190" y="26" class="lbl">skip connections</text>
          </svg>
          <p>Skip connections carry fine detail from the encoder straight to the decoder, which matters for thin structures like vessels. The output is one score per pixel; a sigmoid above {{ threshold|num }} means &ldquo;vessel&rdquo;.</p>
        </div></details>
        <details><summary>Details</summary><div class="body"><p class="small">segmentation-models-pytorch <code>Unet(resnet34)</code>, ImageNet weights, single output channel. <a href="{{ code.model }}">Code</a></p></div></details>
      </div>
      <div class="card">
        <h3>Bootstrap CI and Wilcoxon test</h3>
        <p>Two ways of asking whether a difference between recipes is real or just luck.</p>
        <details><summary>How it works</summary><div class="body">
          <p><strong>{{ term("bootstrap", "Bootstrap") }}:</strong> resample the scores with replacement {{ T[base].n_boot|n }} times and take the middle {{ ci_level|n }}% of the resampled means as a {{ term("ci", "confidence interval") }}.</p>
          <p><strong>Wilcoxon signed-rank:</strong> pair each stain-jitter run with the baseline run that used the same seed, then ask whether the differences lean positive. It is <em>paired</em> because both runs share the same random start, <em>non-parametric</em> because Dice is not normally distributed, and <em>one-sided</em> because each hypothesis predicts a direction.</p>
        </div></details>
        <details><summary>Details</summary><div class="body"><p class="small"><a href="{{ code.bootstrap }}">bootstrap_dice</a> &middot; <a href="{{ code.wilcoxon }}">paired_wilcoxon_dice</a> (scipy)</p></div></details>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================= results -->
<section id="results">
  <div class="wrap">
    <p class="eyebrow">Results</p>
    <h2>What the {{ n_runs|n }} runs say</h2>
    <p class="text">All headline numbers below are <strong>across runs</strong>: each recipe's mean Dice over its {{ n_seeds|n }} training runs, tested with a paired one-sided Wilcoxon across those runs.</p>

        <div class="cards three">
      <div class="card verdict">
        <span class="tag yes">Supported</span>
        <h3>Stain jitter helps</h3>
        <div class="big">{{ T[jitter].mean|f3 }} <span class="muted" style="font-size:16px">vs {{ T[base].mean|f3 }}</span></div>
        <p>Test Dice rises by {{ T[jitter].rel|rel }} over the baseline (p = {{ T[jitter].p|pval }}). Stain jitter beat the baseline in {{ T[jitter].wins|n }} of {{ T[jitter].n|n }} same-seed pairs. Validation agrees: {{ V[jitter].mean|f3 }} vs {{ V[base].mean|f3 }}, p = {{ V[jitter].p|pval }}.</p>
      </div>
      <div class="card verdict">
        <span class="tag yes">Supported by the means</span>
        <h3>Macenko hurts on PAS</h3>
        <div class="big">{{ T[mac].mean|f3 }} <span class="muted" style="font-size:16px">vs {{ T[base].mean|f3 }}</span></div>
        <p>Normalising to an H&amp;E reference lowers test Dice by {{ T[mac].rel|rel }}, and validation Dice too ({{ V[mac].mean|f3 }} vs {{ V[base].mean|f3 }}). The planned test only asked whether it <em>improves</em> on the baseline; it does not (p = {{ T[mac].p|pval }}).</p>
      </div>
      <div class="card verdict">
        <span class="tag no">Not supported</span>
        <h3>The two do not add up</h3>
        <div class="big">{{ T[full].mean|f3 }}</div>
        <p>Combining jitter and normalisation scores below both single recipes. Adding the two separate gains predicts {{ (T[jitter].gain + T[mac].gain)|signed }}; the combination actually gets {{ T[full].gain|signed }}. One plausible factor: this recipe sees Macenko-normalised colours only at test time, never in training. The study did not test that directly.</p>
      </div>
    </div>

    <div class="chart-wrap">
      <h3>Every run, on the test slides</h3>
      <div class="chart" data-spec="seeds_test"></div>
      <p class="how"><strong>How to read this.</strong> Each dot is one training run's mean Dice over the {{ meta.splits.test|n }} test tiles. The grey bar is the {{ ci_level|n }}% bootstrap confidence interval of the recipe's mean across its {{ n_seeds|n }} runs, and the tick is the mean. Dots spreading out means the result depends on the random seed; clusters that do not overlap mean a reliable difference.</p>
    </div>
    <details><summary>Same chart on the validation slide (expert labels)</summary><div class="body">
      <div class="chart" data-spec="seeds_val"></div>
      <p class="small muted">The validation slide is also used to pick each run's best epoch, so its scores lean slightly optimistic. The test slides are the honest comparison.</p>
    </div></details>

    <h3 style="margin-top:56px">The showcase tile, through each model</h3>
    <p class="small muted">
      <span class="swatch" style="background:{{ colors.gt }}"></span>found correctly
      <span class="swatch" style="background:{{ colors.fp }}"></span>marked, but not a vessel
      <span class="swatch" style="background:{{ colors.fn }}"></span>vessel the model missed
    </p>
    <div class="figrow four">
      {%- for arm in arms %}
      {%- set p = meta.images.preds[arm.id] %}
      <figure><img src="{{ p.src }}" alt="{{ arm.label }} prediction with errors coloured" loading="lazy" width="384" height="384">
        <figcaption>{{ dot(arm) }}<strong>{{ arm.label }}</strong> &middot; Dice {{ p.dice|f3 }}</figcaption></figure>
      {%- endfor %}
    </div>
    <p class="fig-note">One run (seed {{ seed|n }}), one selected tile. Illustrative only; the chart above is the evidence.</p>

    <div class="chart-wrap">
      <h3>Stress test: turning the stain up and down</h3>
      <div class="chart" data-spec="sweep_h_scale"></div>
      <p class="how"><strong>How to read this.</strong> The showcase tile is re-stained at each strength and every seed-{{ seed|n }} model predicts again. The shaded band ({{ scale_band[0]|num }} to {{ scale_band[1]|num }}) is the range stain jitter covered in training; beyond it, every model is extrapolating. One tile, so this is an illustration. Try other tiles in the <a href="{{ urls.lab }}">live lab</a>.</p>
    </div>
    <details><summary>Same sweep for the pink (eosin) stain</summary><div class="body"><div class="chart" data-spec="sweep_e_scale"></div></div></details>

    <details>
      <summary>Full results table (across runs)</summary>
      <div class="body table-wrap">
        {%- for split, label, S, SI in [("test", "Test slides", T, TI), ("val", "Validation slide", V, VI)] %}
        <p style="margin-top:12px"><strong>{{ label }}</strong></p>
        <table>
          <thead><tr><th>Recipe</th><th class="num">Mean Dice &plusmn; std</th><th class="num">{{ ci_level|n }}% CI of mean</th><th class="num">vs baseline</th><th class="num">Wins</th><th class="num">p (one-sided)</th><th class="num">Mean IoU</th></tr></thead>
          <tbody>
          {%- for arm in arms %}{% set s = S[arm.id] %}
            <tr><td>{{ dot(arm) }}{{ arm.label }}</td>
              <td class="num">{{ s.mean|f3 }} &plusmn; {{ s.std|f3 }}</td>
              <td class="num">{{ s.lo|f3 }} &ndash; {{ s.hi|f3 }}</td>
              <td class="num">{% if arm.id == base %}&mdash;{% else %}{{ s.rel|rel }}{% endif %}</td>
              <td class="num">{% if arm.id == base %}&mdash;{% else %}{{ s.wins|n }} / {{ s.n|n }}{% endif %}</td>
              <td class="num">{% if s.p is none %}&mdash;{% else %}{{ s.p|pval }}{% endif %}</td>
              <td class="num">{{ SI[arm.id].mean|f3 }}</td></tr>
          {%- endfor %}
          </tbody>
        </table>
        {%- endfor %}
        <p class="small muted">Mean and std over {{ n_seeds|n }} runs. CI: bootstrap ({{ T[base].n_boot|n }} resamples) over the {{ n_seeds|n }} run means. Wins: same-seed pairs where the recipe beat the baseline. {{ term("iou", "IoU") }} is a stricter overlap score than Dice and ranks the recipes the same way.</p>
      </div>
    </details>
    <details>
      <summary>Per-tile statistics for a single run (seed {{ seed|n }})</summary>
      <div class="body table-wrap">
        <table>
          <thead><tr><th>Recipe</th><th class="num">Test mean Dice</th><th class="num">{{ ci_level|n }}% CI over tiles</th><th class="num">p per tile</th></tr></thead>
          <tbody>
          {%- for arm in arms %}{% set s = T[arm.id] %}
            <tr><td>{{ dot(arm) }}{{ arm.label }}</td><td class="num">{{ s.tile_mean|f3 }}</td>
              <td class="num">{{ s.tile_lo|f3 }} &ndash; {{ s.tile_hi|f3 }}</td>
              <td class="num">{% if s.tile_p is none %}&mdash;{% else %}{{ s.tile_p|pval }}{% endif %}</td></tr>
          {%- endfor %}
          </tbody>
        </table>
        <p class="small muted">Here the bootstrap and the Wilcoxon run over the {{ T[base].tile_n|n }} test tiles of one run. That p looks far stronger ({{ T[jitter].tile_p|pval }} for stain jitter) because it treats every tile as independent evidence, but tiles from the same slides are not independent and it is still a single training run. That is why the across-run test above is the headline.</p>
      </div>
    </details>
  </div>
</section>

<!-- ================================================================ lab -->
<section id="lab">
  <div class="wrap">
    <p class="eyebrow">Try it yourself</p>
    <h2>The live lab</h2>
    <p class="text">The four seed-{{ seed|n }} models run live in a small web app. It is free-hosted, so if nobody has used it for a while it may ask you to wake it up first.</p>
    <div class="cards three">
      <div class="card"><h3>Tile explorer</h3><p>Pick a tile by what it shows (where stain jitter helps most, hardest tiles, and so on) and compare all four predictions side by side, with mistakes coloured.</p></div>
      <div class="card"><h3>Stain stress test</h3><p>Turn the purple and pink stains up or down on any tile and watch each model react, with a live run log.</p></div>
      <div class="card"><h3>Your own image</h3><p>Upload a tissue tile and run all four models on it. Nothing is stored.</p></div>
    </div>
    <div class="buttons"><a class="btn primary" href="{{ urls.lab }}">Open the live lab &rarr;</a></div>
  </div>
</section>

<!-- ============================================================= limits -->
<section id="limits">
  <div class="wrap">
    <p class="eyebrow">Limitations and next steps</p>
    <h2>What this does not show</h2>
    <ol class="limits">
      <li><strong>Noisy test labels.</strong> The test slides have auto-generated labels. They are fine for ranking recipes, but the absolute scores understate true accuracy.</li>
      <li><strong>One training slide.</strong> All {{ meta.splits.train|n }} training tiles come from {{ meta.splits.train_wsis|n }} slide. More slides, and more labs, would test the stain question far harder.</li>
      <li><strong>Validation picks the best epoch.</strong> Validation scores are therefore slightly optimistic; the test slides give the honest comparison.</li>
      <li><strong>The stress test uses one tile.</strong> It illustrates the behaviour; the across-run statistics are the evidence.</li>
      <li><strong>The Macenko reference was not fitted to PAS.</strong> A PAS-specific reference might change the second result. That is the natural next experiment, along with training the combined recipe on normalised colours so train and test match.</li>
    </ol>
  </div>
</section>

<!-- ============================================================ glossary -->
<section id="glossary">
  <div class="wrap">
    <p class="eyebrow">Glossary</p>
    <h2>Terms used on this page</h2>
    <dl class="glossary">
      <dt data-key="dice">Dice score</dt><dd>Overlap between the predicted vessels and the labelled vessels: twice the shared area divided by the total area of both. It runs from zero (no overlap) to one (perfect match).</dd>
      <dt data-key="iou">IoU</dt><dd>Intersection over union: the shared area divided by the area covered by either. Stricter than Dice, and always lower for the same prediction.</dd>
      <dt data-key="unet">U-Net</dt><dd>A neural network for image segmentation. It compresses the image into features, then expands them back to label every pixel, with shortcuts that keep fine detail.</dd>
      <dt data-key="seed">Seed</dt><dd>The number that fixes all the randomness in a training run (initial weights, data order, augmentation). Different seeds give slightly different models from identical settings.</dd>
      <dt data-key="wilcoxon">Wilcoxon signed-rank test</dt><dd>A test on paired differences that does not assume a normal distribution. Here it pairs runs that share a seed and asks whether one recipe is consistently better.</dd>
      <dt data-key="pvalue">p-value</dt><dd>How likely a result at least this consistent would be if there were no real difference. Small values mean luck is an unlikely explanation.</dd>
      <dt data-key="ci">Confidence interval</dt><dd>A range that plausibly contains the true mean, given the spread of the data.</dd>
      <dt data-key="bootstrap">Bootstrap</dt><dd>Estimating uncertainty by resampling the observed data many times with replacement and seeing how much the result moves.</dd>
      <dt data-key="wsi">WSI</dt><dd>Whole-slide image: a scan of an entire microscope slide, often tens of thousands of pixels across.</dd>
      <dt data-key="tile">Tile</dt><dd>A small square crop of a whole-slide image, the unit the model sees.</dd>
      <dt data-key="od">Optical density</dt><dd>How much light the tissue absorbs at each pixel. Stains add up linearly in this space, which makes separating them possible.</dd>
      <dt data-key="deconv">Colour deconvolution</dt><dd>Splitting each pixel's colour into the amount of each stain, using the known colour of each stain.</dd>
      <dt data-key="loss">Loss function</dt><dd>The quantity training tries to minimise. Dice loss rewards overlap directly; BCE (binary cross-entropy) scores each pixel separately.</dd>
    </dl>
  </div>
</section>

